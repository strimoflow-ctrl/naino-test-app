# Naino Academy Backend Environment Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=naino_neet_db

# Super Admin Dashboard Credentials (Configure your desired username and password here!)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_super_secure_admin_password
ADMIN_JWT_SECRET=generate_a_random_secure_jwt_token_secret_here

# JWT Secrets for Mobile App Student Authentication
JWT_SECRET=naino_neet_jwt_super_access_secret_key_2026_xyz99
JWT_REFRESH_SECRET=naino_neet_jwt_refresh_secure_secret_key_2026_abc88

# Private Security Handshake (prevents unauthorized bots/scrapers)
APP_SECRET_KEY=naino_secret_mobile_handshake_2026

# Optional: Gmail Free SMTP for In-App 6-Digit Password Reset OTP
SMTP_USER=
SMTP_PASS=
